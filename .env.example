# Copy to .env and fill in. .env is git-ignored and must stay that way.

# The registry keeps one file; everything else is disposable.
ECOM_DB_PATH=/var/lib/ecom/registry.sqlite

# 64 hex characters you generate. Whoever holds this can write to the whole
# record. Rotate on the server first, restart, then update the MCP client.
#   openssl rand -hex 32
ECOM_API_TOKEN=

# Optional: git remote for automatic snapshots (create_backup + timer).
# If this is a public repository, so is your record.
ECOM_BACKUP_REMOTE=

# Subscriber addresses. MUST be a different file from ECOM_DB_PATH: the
# registry is snapshotted and pushed by create_backup, and a published
# backup carrying an e-mail list cannot be un-published.
ECOM_SUBSCRIBERS_DB=/var/lib/ecom/subscribers.sqlite

# Optional: salt for publication pseudonyms. Keep it out of the repository —
# same salt means stable labels across publishes.
ECOM_PSEUDONYM_SALT=
